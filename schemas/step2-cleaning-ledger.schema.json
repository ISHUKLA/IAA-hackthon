{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/iaa/step2-cleaning-ledger.schema.json",
  "title": "Step 2 row-level cleaning ledger record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_file",
    "row_id",
    "entity_key",
    "field",
    "original_value",
    "derived_value",
    "rule_id",
    "rule_version",
    "reason",
    "evidence_status",
    "change_status"
  ],
  "properties": {
    "source_file": {"type": "string", "minLength": 1},
    "row_id": {"type": ["string", "null"]},
    "entity_key": {"type": "string", "minLength": 1},
    "field": {"type": "string", "minLength": 1},
    "original_value": {"type": ["string", "null"], "description": "Canonical JSON scalar text preserving null."},
    "derived_value": {"type": ["string", "null"], "description": "Canonical JSON scalar text preserving null."},
    "rule_id": {"type": "string", "minLength": 1},
    "rule_version": {"type": "integer", "minimum": 1},
    "reason": {"type": "string", "minLength": 1},
    "evidence_status": {
      "enum": ["verified", "prior_measured_to_reverify", "inferred", "unresolved"]
    },
    "change_status": {
      "enum": ["unchanged", "changed", "candidate", "exception", "invalid"]
    }
  }
}
