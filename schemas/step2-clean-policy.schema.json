{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/iaa/step2-clean-policy.schema.json",
  "title": "Step 2 clean policy logical row contract",
  "description": "Common added fields. Original source columns remain unchanged and line-specific, so additional properties are retained.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "row_id",
    "policy_id",
    "source_file",
    "line",
    "split",
    "customer_id_raw",
    "customer_id_clean",
    "customer_id_changed",
    "customer_id_reason",
    "exposure_raw",
    "exposure_clean",
    "exposure_classification",
    "exposure_changed",
    "exposure_reason",
    "covered_days_inclusive",
    "sum_insured_raw",
    "sum_insured_candidate",
    "sum_insured_unit_error_flag",
    "sum_insured_proposed_divisor",
    "sum_insured_candidate_reason",
    "sum_insured_candidate_status",
    "customer_join_status",
    "address_join_status",
    "weather_join_status",
    "weather_year",
    "cleaning_config_version"
  ],
  "properties": {
    "row_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "source_file": {"type": "string", "minLength": 1},
    "line": {"enum": ["motor", "buildings", "contents"]},
    "split": {"enum": ["train", "test"]},
    "customer_id_raw": {"type": ["string", "null"]},
    "customer_id_clean": {"type": ["string", "null"]},
    "customer_id_changed": {"type": "boolean"},
    "customer_id_reason": {"type": "string", "minLength": 1},
    "exposure_raw": {"type": ["number", "null"]},
    "exposure_clean": {"type": ["number", "null"]},
    "exposure_classification": {
      "enum": ["matches_act365", "stored_day_units", "stored_360_basis", "unresolved_mismatch", "invalid_dates"]
    },
    "exposure_changed": {"type": "boolean"},
    "exposure_reason": {"type": "string", "minLength": 1},
    "covered_days_inclusive": {"type": ["integer", "null"], "minimum": 1},
    "sum_insured_raw": {"type": ["number", "null"]},
    "sum_insured_candidate": {"type": ["number", "null"]},
    "sum_insured_unit_error_flag": {"type": ["boolean", "null"]},
    "sum_insured_proposed_divisor": {"type": ["number", "null"]},
    "sum_insured_candidate_reason": {"type": ["string", "null"]},
    "sum_insured_candidate_status": {"enum": ["not_applicable", "unchanged", "inferred", "ambiguous", "missing"]},
    "customer_join_status": {"enum": ["matched", "missing_key", "unresolved_reference", "not_checked"]},
    "address_join_status": {"enum": ["matched", "missing_key", "unresolved_reference", "not_checked"]},
    "weather_join_status": {"enum": ["matched", "missing_key", "unresolved_reference", "cross_year_period", "not_checked"]},
    "weather_year": {"type": ["integer", "null"]},
    "telematics_score_missing": {"type": "boolean"},
    "telematics_missing_reason": {
      "enum": ["score_present", "structural_non_opt_in", "unexpected_opted_in_missing", "unexpected_non_opt_in_score", "unknown_opt_in_status"]
    },
    "licence_start_age_derived": {"type": ["number", "null"]},
    "licence_start_age_below_14_flag": {"type": "boolean"},
    "cleaning_config_version": {"const": "step2-cleaning-v1"}
  }
}
